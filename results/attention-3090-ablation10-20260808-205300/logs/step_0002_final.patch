+// ---------------- CPU reference ----------------
+static void ref_attn(const std::vector<__nv_bfloat16>& q,
+                     const std::vector<__nv_bfloat16>& k,
+                     const std::vector<__nv_bfloat16>& v,
+                     std::vector<__nv_bfloat16>& out,
+                     int B, int H, int S, int kv_heads, bool causal) {
+    const float scale = 1.0f / sqrtf(128.0f);
+    const int hpk = H / kv_heads;
+    std::vector<float> s(S), p(S);
+    for (int bb = 0; bb < B; ++bb)
+    for (int h = 0; h < H; ++h) {
+        const int kvh = hpk > 1 ? h / hpk : h;
+        for (int r = 0; r < S; ++r) {
+            const int lim = causal ? r + 1 : S;
+            float m = -INFINITY;
+            for (int c = 0; c < lim; ++c) {
+                float acc = 0.f;
+                for (int d = 0; d < HEAD_DIM; ++d) {
+                    float qv = __bfloat162float(q[((long long)bb*H + h)*S*HEAD_DIM + r*HEAD_DIM + d]);
+                    float kv_ = __bfloat162float(k[((long long)bb*kv_heads + kvh)*S*HEAD_DIM + c*HEAD_DIM + d]);
+                    acc += qv * kv_;
+                }
+                s[c] = acc * scale;
+                m = fmaxf(m, s[c]);
+            }
+            float l = 0.f;
+            for (int c = 0; c < lim; ++c) { p[c] = expf(s[c] - m); l += p[c]; }
+            for (int d = 0; d < HEAD_DIM; ++d) {
+                float acc = 0.f;
+                for (int c = 0; c < lim; ++c) {
+                    float vv = __bfloat162float(v[((long long)bb*kv_heads + kvh)*S*HEAD_DIM + c*HEAD_DIM + d]);
+                    acc += p[c] * vv;
+                }
+                out[((long long)bb*H + h)*S*HEAD_DIM + r*HEAD_DIM + d] =
+                    __float2bfloat16(acc / l);
+            }
+        }
+    }
+}
+
+int main(int argc, char** argv) {
+    int B = 1, H = 1, S = 64;
+    bool causal = false;
+    int kv_heads = 1;
+    if (argc > 1) B = atoi(argv[1]);
+    if (argc > 2) H = atoi(argv[2]);
+    if (argc > 3) S = atoi(argv[3]);
+    if (argc > 4) causal = atoi(argv[4]);
+    if (argc > 5) kv_heads = atoi(argv[5]);
+
+    const long long total = (long long)B * H * S * HEAD_DIM;
+    std::vector<__nv_bfloat16> q(total), k(total), v(total), out(total);
+    unsigned seed = 12345;
+    for (auto& x : q) x = __float2bfloat16(((float)(rand_r(&seed) % 2000) - 1000.f) / 100.f);
+    for (auto& x : k) x = __float2bfloat16(((float)(rand_r(&seed) % 2000) - 1000.f) / 100.f);
+    for (auto& x : v) x = __float2bfloat16(((float)(rand_r(&seed) % 2000) - 1000.f) / 100.f);
+
+    std::vector<__nv_bfloat16> ref(total);
+    ref_attn(q, k, v, ref, B, H, S, kv_heads, causal);
+
+    __nv_bfloat16 *dq, *dk, *dv, *dout;
+    cudaMalloc(&dq, total * 2); cudaMalloc(&dk, total * 2);
+    cudaMalloc(&dv, total * 2); cudaMalloc(&dout, total * 2);
+    cudaMemcpy(dq, q.data(), total * 2, cudaMemcpyHostToDevice);
+    cudaMemcpy(dk, k.data(), total * 2, cudaMemcpyHostToDevice);
+    cudaMemcpy(dv, v.data(), total * 2, cudaMemcpyHostToDevice);
+
+    const float scale = 1.0f / sqrtf(128.0f);
+    dim3 grid((S + BLOCK_M - 1) / BLOCK_M, B * H);
+    cudaFuncSetAttribute(attn_kernel, cudaFuncAttributeMaxDynamicSharedMemorySize, SMEM_BYTES);
+    attn_kernel<<<grid, NUM_THREADS, SMEM_BYTES>>>(dq, dk, dv, dout, S, scale, causal, H, kv_heads);
+    cudaError_t err = cudaDeviceSynchronize();
+    if (err != cudaSuccess) { printf("KERNEL ERROR: %s\n", cudaGetErrorString(err)); return 1; }
+
+    cudaMemcpy(out.data(), dout, total * 2, cudaMemcpyDeviceToHost);
+
+    double maxerr = 0, sumerr = 0;
+    long long worst = -1;
+    float worst_ref = 0, worst_got = 0;
+    int worst_r = -1, worst_d = -1;
+    for (long long i = 0; i < total; ++i) {
+        float a = __bfloat162float(ref[i]);
+        float b = __bfloat162float(out[i]);
+        double e = fabs((double)a - b);
+        sumerr += e;
+        if (e > maxerr) { maxerr = e; worst = i; worst_ref = a; worst_got = b; }
+    }
+    long long wb = worst / ((long long)H * S * HEAD_DIM);
+    long long wr = (worst % ((long long)S * HEAD_DIM)) / HEAD_DIM;
+    long long wd = worst % HEAD_DIM;
+    printf("B=%d H=%d S=%d causal=%d kv_heads=%d: max_abs_err=%.6g avg=%.6g\n",
+           B, H, S, (int)causal, kv_heads, maxerr, sumerr / total);
+    printf("  worst at (b=%lld r=%lld d=%lld): ref=%.4f got=%.4f\n", wb, wr, wd, worst_ref, worst_got);
+
+    // ---- S dump check: compare s_dump_kernel S against CPU QK^T ----
+    if (B == 1 && H == 1) {
+        float *ds;
+        cudaMalloc(&ds, 16 * 64 * sizeof(float));
+        std::vector<float> s_cpu(16 * 64), s_gpu(16 * 64);
+        for (int r = 0; r < 16; ++r)
+            for (int c = 0; c < 64; ++c) {
+                float acc = 0.f;
+                for (int d = 0; d < HEAD_DIM; ++d)
+                    acc += __bfloat162float(q[r * HEAD_DIM + d]) *
+                           __bfloat162float(k[c * HEAD_DIM + d]);
+                s_cpu[r * 64 + c] = acc * scale;
+            }
+        cudaFuncSetAttribute(s_dump_kernel, cudaFuncAttributeMaxDynamicSharedMemorySize, SMEM_BYTES);
+        s_dump_kernel<<<1, NUM_THREADS, SMEM_BYTES>>>(dq, dk, ds, S, scale);
+        cudaDeviceSynchronize();
+        cudaMemcpy(s_gpu.data(), ds, 16 * 64 * sizeof(float), cudaMemcpyDeviceToHost);
+        double smax = 0;
+        long long sworst = -1;
+        for (int i = 0; i < 16 * 64; ++i) {
+            double e = fabs((double)s_cpu[i] - s_gpu[i]);
+            if (e > smax) { smax = e; sworst = i; }
+        }
+        printf("  S dump: max_abs_err=%.6g at (r=%lld c=%lld) cpu=%.4f gpu=%.4f\n",
+               smax, sworst / 64, sworst % 64, s_cpu[sworst], s_gpu[sworst]);
+        cudaFree(ds);
+
+        // ---- P/l/O dump check ----
+        float *dp, *dl, *dm, *do_, *ds2;
+        cudaMalloc(&dp, 16 * 64 * sizeof(float));
+        cudaMalloc(&dl, 16 * sizeof(float));
+        cudaMalloc(&dm, 16 * sizeof(float));
+        cudaMalloc(&do_, 16 * HEAD_DIM * sizeof(float));
+        cudaMalloc(&ds2, 16 * 64 * sizeof(float));
+        std::vector<float> p_cpu(16 * 64), l_cpu(16), o_cpu(16 * HEAD_DIM);
+        for (int r = 0; r < 16; ++r) {
+            float mx = -INFINITY;
+            for (int c = 0; c < 64; ++c) {
+                float acc = 0.f;
+                for (int d = 0; d < HEAD_DIM; ++d)
+                    acc += __bfloat162float(q[r * HEAD_DIM + d]) *
+                           __bfloat162float(k[c * HEAD_DIM + d]);
+                p_cpu[r * 64 + c] = acc * scale;
+                mx = fmaxf(mx, p_cpu[r * 64 + c]);
+            }
+            l_cpu[r] = 0.f;
+            for (int c = 0; c < 64; ++c) {
+                p_cpu[r * 64 + c] = expf(p_cpu[r * 64 + c] - mx);
+                l_cpu[r] += p_cpu[r * 64 + c];
+            }
+        }
+        for (int r = 0; r < 16; ++r)
+            for (int d = 0; d < HEAD_DIM; ++d) {
+                float acc = 0.f;
+                for (int c = 0; c < 64; ++c)
+                    acc += p_cpu[r * 64 + c] * __bfloat162float(v[c * HEAD_DIM + d]);
+                o_cpu[r * HEAD_DIM + d] = acc;
+            }
+        cudaFuncSetAttribute(pv_dump_kernel, cudaFuncAttributeMaxDynamicSharedMemorySize, SMEM_BYTES);
+        pv_dump_kernel<<<1, NUM_THREADS, SMEM_BYTES>>>(dq, dk, dv, dp, dl, dm, do_, ds2, S, scale);
+        cudaError_t perr = cudaDeviceSynchronize();
+        if (perr != cudaSuccess) { printf("pv_dump ERROR: %s\n", cudaGetErrorString(perr)); return 1; }
+        std::vector<float> p_gpu(16 * 64), l_gpu(16), m_gpu(16), o_gpu(16 * HEAD_DIM);
+        cudaMemcpy(p_gpu.data(), dp, 16 * 64 * sizeof(float), cudaMemcpyDeviceToHost);
+        cudaMemcpy(l_gpu.data(), dl, 16 * sizeof(float), cudaMemcpyDeviceToHost);
+        cudaMemcpy(m_gpu.data(), dm, 16 * sizeof(float), cudaMemcpyDeviceToHost);
+        cudaMemcpy(o_gpu.data(), do_, 16 * HEAD_DIM * sizeof(float), cudaMemcpyDeviceToHost);
+        double pmax = 0; long long pworst = -1;
+        for (int i = 0; i < 16 * 64; ++i) {
+            double e = fabs((double)p_cpu[i] - p_gpu[i]);
+            if (e > pmax) { pmax = e; pworst = i; }
+        }
+        double omax = 0; long long oworst = -1;
+        for (int i = 0; i < 16 * HEAD_DIM; ++i) {
+            double e = fabs((double)o_cpu[i] - o_gpu[i]);
+            if (e > omax) { omax = e; oworst = i; }
+        }
+        double lmax = 0; long long lworst = -1;
+        for (int i = 0; i < 16; ++i) {
+            double e = fabs((double)l_cpu[i] - l_gpu[i]);
+            if (e > lmax) { lmax = e; lworst = i; }
+        }
+        printf("  P dump: max_abs_err=%.6g at (r=%lld c=%lld) cpu=%.4f gpu=%.4f\n",
+               pmax, pworst / 64, pworst % 64, p_cpu[pworst], p_gpu[pworst]);
+        printf("  O dump: max_abs_err=%.6g at (r=%lld d=%lld) cpu=%.4f gpu=%.4f\n",
+               omax, oworst / HEAD_DIM, oworst % HEAD_DIM, o_cpu[oworst], o_gpu[oworst]);
+        printf("  l dump: max_abs_err=%.6g at r=%lld cpu=%.4f gpu=%.4f\n",
+               lmax, lworst, l_cpu[lworst], l_gpu[lworst]);
+        printf("  m_gpu: ");
+        for (int i = 0; i < 16; ++i) printf("%.2f ", m_gpu[i]);
+        printf("\n");
+        double smax2 = 0;
+        for (int i = 0; i < 16 * 64; ++i) {
+            double e = fabs((double)s_cpu[i] - p_gpu[i]);
+            if (e > smax2) smax2 = e;
+        }
+        printf("  s_frag from pv_dump: max_abs_err vs cpu=%.6g\n", smax2);
+        // compare ds2 (fresh s2 buffer) against cpu s
+        std::vector<float> s2_gpu(16 * 64);
+        cudaMemcpy(s2_gpu.data(), ds2, 16 * 64 * sizeof(float), cudaMemcpyDeviceToHost);
+        double s2max = 0; long long s2worst = -1;
+        for (int i = 0; i < 16 * 64; ++i) {
+            double e = fabs((double)s_cpu[i] - s2_gpu[i]);
+            if (e > s2max) { s2max = e; s2worst = i; }
+        }
+        printf("  s2 fresh: max_abs_err=%.6g at (r=%lld c=%lld)\n",
+               s2max, s2worst / 64, s2worst % 64);
+        cudaFree(ds2);
+        cudaFree(dp); cudaFree(dl); cudaFree(dm); cudaFree(do_);
+    }
+
+    cudaFree(dq); cudaFree(dk); cudaFree(dv); cudaFree(dout);
+    return maxerr < 0.01 ? 0 : 2;
+}
