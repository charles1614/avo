+// Standalone debug harness: copies the attention kernel (no torch) and checks
+// against a CPU fp32 reference. NOT part of the final solution.
+#include <cuda_bf16.h>
+#include <mma.h>
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <cstdint>
+#include <vector>
+#include <algorithm>
+
+using namespace nvcuda;
+
+constexpr int BLOCK_M = 64;
+constexpr int BLOCK_N = 64;
+constexpr int HEAD_DIM = 128;
+constexpr int NUM_WARPS = 4;
+constexpr int NUM_THREADS = NUM_WARPS * 32;
+constexpr int PADDED_D = HEAD_DIM + 8;
+constexpr int TILE_ELEMS = BLOCK_N * PADDED_D;
+constexpr int O_ELEMS = BLOCK_M * PADDED_D;
+constexpr int SMEM_BYTES = 4 * TILE_ELEMS * 2 + O_ELEMS * 2;
+
+__device__ __forceinline__ void cp_async16(void* smem, const void* gmem) {
+    uint32_t s = static_cast<uint32_t>(__cvta_generic_to_shared(smem));
+    asm volatile("cp.async.cg.shared.global [%0], [%1], 16;\n" :: "r"(s), "l"(gmem));
+}
+__device__ __forceinline__ void cp_async_commit() {
+    asm volatile("cp.async.commit_group;\n");
+}
+template<int N>
+__device__ __forceinline__ void cp_async_wait() {
+    asm volatile("cp.async.wait_group %0;\n" :: "n"(N));
+}
+
+__device__ __forceinline__ void load_tile(
+    const __nv_bfloat16* __restrict__ src, __nv_bfloat16* __restrict__ dst,
+    int row0, int seq_len)
+{
+    constexpr int CHUNKS = BLOCK_N * HEAD_DIM / 8;
+#pragma unroll
+    for (int i = threadIdx.x; i < CHUNKS; i += NUM_THREADS) {
+        const int row = i / (HEAD_DIM / 8);
+        const int col8 = i % (HEAD_DIM / 8);
+        const int grow = row0 + row;
+        __nv_bfloat16* s = dst + row * PADDED_D + col8 * 8;
+        if (grow < seq_len) {
+            cp_async16(s, src + (long long)grow * HEAD_DIM + col8 * 8);
+        } else {
+            *reinterpret_cast<uint4*>(s) = make_uint4(0, 0, 0, 0);
+        }
+    }
+}
+
+__device__ __forceinline__ float warp_max4(float v) {
+#pragma unroll
+    for (int off = 1; off < 4; off <<= 1)
+        v = fmaxf(v, __shfl_xor_sync(0xffffffffu, v, off));
+    return v;
+}
+__device__ __forceinline__ float warp_sum4(float v) {
+#pragma unroll
+    for (int off = 1; off < 4; off <<= 1)
+        v += __shfl_xor_sync(0xffffffffu, v, off);
+    return v;
+}
+
+__global__ void __launch_bounds__(NUM_THREADS, 1)
+attn_kernel(const __nv_bfloat16* __restrict__ q,
+            const __nv_bfloat16* __restrict__ k,
+            const __nv_bfloat16* __restrict__ v,
+            __nv_bfloat16* __restrict__ out,
+            int seq_len, float scale, bool causal,
+            int num_heads, int kv_heads)
+{
+    extern __shared__ char smem[];
+    __nv_bfloat16* sK0 = reinterpret_cast<__nv_bfloat16*>(smem);
+    __nv_bfloat16* sV0 = sK0 + TILE_ELEMS;
+    __nv_bfloat16* sK1 = sV0 + TILE_ELEMS;
+    __nv_bfloat16* sV1 = sK1 + TILE_ELEMS;
+    __nv_bfloat16* sQO = sV1 + TILE_ELEMS;
+
+    const int m_tile = blockIdx.x;
+    const int bh = blockIdx.y;
+    const int b = bh / num_heads;
+    const int h = bh % num_heads;
+    const int h_per_kv = num_heads / kv_heads;
+    const int kvh = h_per_kv > 1 ? h / h_per_kv : h;
+    const long long qbase = (long long)bh * seq_len * HEAD_DIM;
+    const long long kvbase = ((long long)(b * kv_heads + kvh)) * seq_len * HEAD_DIM;
+
+    const int warp = threadIdx.x / 32;
+    const int lane = threadIdx.x % 32;
+    const int m0 = m_tile * BLOCK_M + warp * 16;
+    const int m0b = m_tile * BLOCK_M;
+
+    load_tile(q + qbase, sQO, m0b, seq_len);
+    cp_async_commit();
+    cp_async_wait<0>();
+    __syncthreads();
+
+    wmma::fragment<wmma::matrix_a, 16, 16, 16, __nv_bfloat16, wmma::row_major> q_frag[8];
+#pragma unroll
+    for (int kt = 0; kt < 8; ++kt)
+        wmma::load_matrix_sync(q_frag[kt], sQO + warp * 16 * PADDED_D + kt * 16, PADDED_D);
+
+    wmma::fragment<wmma::accumulator, 16, 16, 16, float> s_frag[4];
+    wmma::fragment<wmma::matrix_a, 16, 16, 16, __nv_bfloat16, wmma::row_major> p_frag[4];
+    wmma::fragment<wmma::accumulator, 16, 16, 16, float> o_frag[8];
+    wmma::fragment<wmma::matrix_b, 16, 16, 16, __nv_bfloat16, wmma::col_major> k_frag;
+    wmma::fragment<wmma::matrix_b, 16, 16, 16, __nv_bfloat16, wmma::row_major> v_frag;
+
+#pragma unroll
+    for (int i = 0; i < 8; ++i) wmma::fill_fragment(o_frag[i], 0.f);
+
+    float m_prev[2] = {-INFINITY, -INFINITY};
+    float l_prev[2] = {0.f, 0.f};
+
+    const int n_tiles_total = (seq_len + BLOCK_N - 1) / BLOCK_N;
+    const int n_tiles_block =
+        causal ? min(n_tiles_total, (m0b + BLOCK_M - 1) / BLOCK_N + 1) : n_tiles_total;
+
+    if (n_tiles_block > 0) {
+        load_tile(k + kvbase, sK0, 0, seq_len);
+        load_tile(v + kvbase, sV0, 0, seq_len);
+        cp_async_commit();
+    }
+
+    for (int nt = 0; nt < n_tiles_block; ++nt) {
+        const int buf = nt & 1;
+        __nv_bfloat16* sK = buf ? sK1 : sK0;
+        __nv_bfloat16* sV = buf ? sV1 : sV0;
+        if (nt + 1 < n_tiles_block) {
+            load_tile(k + kvbase, buf ? sK0 : sK1, (nt + 1) * BLOCK_N, seq_len);
+            load_tile(v + kvbase, buf ? sV0 : sV1, (nt + 1) * BLOCK_N, seq_len);
+            cp_async_commit();
+        }
+        if (nt + 1 < n_tiles_block) cp_async_wait<1>(); else cp_async_wait<0>();
+        __syncthreads();
+
+        const int kv0 = nt * BLOCK_N;
+
+#pragma unroll
+        for (int i = 0; i < 4; ++i) {
+            const int kvc = kv0 + 16 * i;
+#pragma unroll
+            for (int j = 0; j < 8; ++j) {
+                s_frag[i].x[j] = 0.f;
+                p_frag[i].x[j] = __float2bfloat16(0.f);
+            }
+            if (causal && kvc > m0 + 15) continue;
+            const bool may_mask = causal && (kvc + 15 >= m0) && (kvc <= m0 + 15);
+#pragma unroll
+            for (int kt = 0; kt < 8; ++kt) {
+                wmma::load_matrix_sync(k_frag, sK + (16 * i) * PADDED_D + kt * 16, PADDED_D);
+                wmma::mma_sync(s_frag[i], q_frag[kt], k_frag, s_frag[i]);
+            }
+#pragma unroll
+            for (int j = 0; j < 8; ++j) s_frag[i].x[j] *= scale;
+            if (may_mask) {
+#pragma unroll
+                for (int j = 0; j < 8; ++j) {
+                    const int rr = ((j & 2) ? 8 : 0) + lane / 4;
+                    const int cc = 2 * (lane % 4) + (j & 1) + ((j & 4) ? 8 : 0);
+                    if (kvc + cc > m0 + rr) s_frag[i].x[j] = -INFINITY;
+                }
+            }
+            float tm0 = fmaxf(fmaxf(s_frag[i].x[0], s_frag[i].x[1]),
+                              fmaxf(s_frag[i].x[4], s_frag[i].x[5]));
+            float tm1 = fmaxf(fmaxf(s_frag[i].x[2], s_frag[i].x[3]),
+                              fmaxf(s_frag[i].x[6], s_frag[i].x[7]));
+            tm0 = warp_max4(tm0);
+            tm1 = warp_max4(tm1);
+            const float mn0 = fmaxf(m_prev[0], tm0);
+            const float mn1 = fmaxf(m_prev[1], tm1);
+            const float corr0 = __expf(m_prev[0] - mn0);
+            const float corr1 = __expf(m_prev[1] - mn1);
+#pragma unroll
+            for (int o = 0; o < 8; ++o) {
+#pragma unroll
+                for (int j = 0; j < 8; ++j)
+                    o_frag[o].x[j] *= ((j & 2) ? corr1 : corr0);
+            }
+            float ps0 = 0.f, ps1 = 0.f;
+#pragma unroll
+            for (int j = 0; j < 8; ++j) {
+                const float p = __expf(s_frag[i].x[j] - ((j & 2) ? mn1 : mn0));
+                s_frag[i].x[j] = p;
+                if (j & 2) ps1 += p; else ps0 += p;
+            }
+            ps0 = warp_sum4(ps0);
+            ps1 = warp_sum4(ps1);
+            l_prev[0] = l_prev[0] * corr0 + ps0;
+            l_prev[1] = l_prev[1] * corr1 + ps1;
+            m_prev[0] = mn0;
+            m_prev[1] = mn1;
+#pragma unroll
+            for (int j = 0; j < 8; ++j)
+                p_frag[i].x[j] = __float2bfloat16(s_frag[i].x[j]);
+        }
+
+#pragma unroll
+        for (int ot8 = 0; ot8 < 8; ++ot8) {
+#pragma unroll
+            for (int kc = 0; kc < 4; ++kc) {
+                wmma::load_matrix_sync(v_frag, sV + (16 * kc) * PADDED_D + ot8 * 16, PADDED_D);
+                wmma::mma_sync(o_frag[ot8], p_frag[kc], v_frag, o_frag[ot8]);
+            }
+        }
+        __syncthreads();
+    }
+
+    const float inv0 = 1.f / l_prev[0];
+    const float inv1 = 1.f / l_prev[1];
+#pragma unroll
+    for (int ot8 = 0; ot8 < 8; ++ot8) {
+        const int d0 = ot8 * 16;
+#pragma unroll
+        for (int j = 0; j < 8; ++j) {
+            const int rr = ((j & 2) ? 8 : 0) + lane / 4;
+            const int cc = 2 * (lane % 4) + (j & 1) + ((j & 4) ? 8 : 0);
+            const int grow = m0 + rr;
+            if (grow < seq_len) {
+                sQO[(grow - m0b) * PADDED_D + d0 + cc] =
+                    __float2bfloat16(o_frag[ot8].x[j] * ((j & 2) ? inv1 : inv0));
+            }
+        }
+    }
+    __syncthreads();
+    {
+        constexpr int OUT_CHUNKS = BLOCK_M * HEAD_DIM / 8;
+#pragma unroll
+        for (int i = threadIdx.x; i < OUT_CHUNKS; i += NUM_THREADS) {
+            const int row = i / (HEAD_DIM / 8);
+            const int col8 = i % (HEAD_DIM / 8);
+            const int grow = m0b + row;
+            if (grow < seq_len) {
+                *reinterpret_cast<uint4*>(
+                    out + qbase + (long long)grow * HEAD_DIM + col8 * 8) =
+                    *reinterpret_cast<const uint4*>(sQO + row * PADDED_D + col8 * 8);
+            }
+        }
+    }
+}
+
+// ---------------- S dump kernel (debug) ----------------
+// Computes S[16x64] for warp 0 of block 0, writes via (rr,cc) mapping.
+__global__ void s_dump_kernel(const __nv_bfloat16* __restrict__ q,
+                              const __nv_bfloat16* __restrict__ k,
+                              float* s_out, int seq_len, float scale)
+{
+    extern __shared__ char smem[];
+    __nv_bfloat16* sK0 = reinterpret_cast<__nv_bfloat16*>(smem);
+    __nv_bfloat16* sV0 = sK0 + TILE_ELEMS;
+    __nv_bfloat16* sK1 = sV0 + TILE_ELEMS;
+    __nv_bfloat16* sV1 = sK1 + TILE_ELEMS;
+    __nv_bfloat16* sQO = sV1 + TILE_ELEMS;
+
+    const int warp = threadIdx.x / 32;
+    const int lane = threadIdx.x % 32;
+
+    load_tile(q, sQO, 0, seq_len);
+    cp_async_commit();
+    cp_async_wait<0>();
+    __syncthreads();
+
+    wmma::fragment<wmma::matrix_a, 16, 16, 16, __nv_bfloat16, wmma::row_major> q_frag[8];
+#pragma unroll
+    for (int kt = 0; kt < 8; ++kt)
+        wmma::load_matrix_sync(q_frag[kt], sQO + warp * 16 * PADDED_D + kt * 16, PADDED_D);
+
+    load_tile(k, sK0, 0, seq_len);
+    cp_async_commit();
+    cp_async_wait<0>();
+    __syncthreads();
+
+    wmma::fragment<wmma::accumulator, 16, 16, 16, float> s_frag[4];
+    wmma::fragment<wmma::matrix_b, 16, 16, 16, __nv_bfloat16, wmma::col_major> k_frag;
+#pragma unroll
+    for (int i = 0; i < 4; ++i) {
+#pragma unroll
+        for (int j = 0; j < 8; ++j) s_frag[i].x[j] = 0.f;
+#pragma unroll
+        for (int kt = 0; kt < 8; ++kt) {
+            wmma::load_matrix_sync(k_frag, sK0 + (16 * i) * PADDED_D + kt * 16, PADDED_D);
+            wmma::mma_sync(s_frag[i], q_frag[kt], k_frag, s_frag[i]);
+        }
+        if (warp != 0) continue;
+#pragma unroll
+        for (int j = 0; j < 8; ++j) {
+            const int rr = ((j & 2) ? 8 : 0) + lane / 4;
+            const int cc = 2 * (lane % 4) + (j & 1) + ((j & 4) ? 8 : 0);
+            s_out[(rr * 64 + 16 * i + cc)] = s_frag[i].x[j] * scale;
+        }
+    }
+}
+
+// ---------------- P/l/O dump kernel (debug) ----------------
+// Same computation as attn_kernel for warp 0 of a single block, but dumps
+// p[16x64], l[16], m[16], o_unnorm[16x128] to global buffers.
+__global__ void pv_dump_kernel(const __nv_bfloat16* __restrict__ q,
+                               const __nv_bfloat16* __restrict__ k,
+                               const __nv_bfloat16* __restrict__ v,
+                               float* p_out, float* l_out, float* m_out,
+                               float* o_out, float* s2_out, int seq_len, float scale)
+{
+    extern __shared__ char smem[];
+    __nv_bfloat16* sK0 = reinterpret_cast<__nv_bfloat16*>(smem);
+    __nv_bfloat16* sV0 = sK0 + TILE_ELEMS;
+    __nv_bfloat16* sK1 = sV0 + TILE_ELEMS;
+    __nv_bfloat16* sV1 = sK1 + TILE_ELEMS;
+    __nv_bfloat16* sQO = sV1 + TILE_ELEMS;
+
+    const int warp = threadIdx.x / 32;
+    const int lane = threadIdx.x % 32;
+
+    load_tile(q, sQO, 0, seq_len);
+    cp_async_commit();
+    cp_async_wait<0>();
+    __syncthreads();
+
+    wmma::fragment<wmma::matrix_a, 16, 16, 16, __nv_bfloat16, wmma::row_major> q_frag[8];
+#pragma unroll
+    for (int kt = 0; kt < 8; ++kt)
+        wmma::load_matrix_sync(q_frag[kt], sQO + warp * 16 * PADDED_D + kt * 16, PADDED_D);
+
+    load_tile(k, sK0, 0, seq_len);
+    load_tile(v, sV0, 0, seq_len);
+    cp_async_commit();
+    cp_async_wait<0>();
+    __syncthreads();
+
+    wmma::fragment<wmma::accumulator, 16, 16, 16, float> s_frag[4];
+    wmma::fragment<wmma::matrix_a, 16, 16, 16, __nv_bfloat16, wmma::row_major> p_frag[4];
+    wmma::fragment<wmma::accumulator, 16, 16, 16, float> o_frag[8];
+    wmma::fragment<wmma::matrix_b, 16, 16, 16, __nv_bfloat16, wmma::col_major> k_frag;
+    wmma::fragment<wmma::matrix_b, 16, 16, 16, __nv_bfloat16, wmma::row_major> v_frag;
+
+#pragma unroll
+    for (int i = 0; i < 8; ++i) wmma::fill_fragment(o_frag[i], 0.f);
+
+    float m_prev[2] = {-INFINITY, -INFINITY};
+    float l_prev[2] = {0.f, 0.f};
+
+    const int n_tiles_block = (seq_len + BLOCK_N - 1) / BLOCK_N;
+
+    if (n_tiles_block > 0) {
+        load_tile(k, sK0, 0, seq_len);
+        load_tile(v, sV0, 0, seq_len);
+        cp_async_commit();
+    }
+
+    for (int nt = 0; nt < n_tiles_block; ++nt) {
+        const int buf = nt & 1;
+        __nv_bfloat16* sK = buf ? sK1 : sK0;
+        __nv_bfloat16* sV = buf ? sV1 : sV0;
+        if (nt + 1 < n_tiles_block) {
+            load_tile(k, buf ? sK0 : sK1, (nt + 1) * BLOCK_N, seq_len);
+            load_tile(v, buf ? sV0 : sV1, (nt + 1) * BLOCK_N, seq_len);
+            cp_async_commit();
+        }
+        if (nt + 1 < n_tiles_block) cp_async_wait<1>(); else cp_async_wait<0>();
+        __syncthreads();
+
+        const int kv0 = nt * BLOCK_N;
+
+#pragma unroll
+        for (int i = 0; i < 4; ++i) {
+            const int kvc = kv0 + 16 * i;
+#pragma unroll
+            for (int j = 0; j < 8; ++j) {
+                s_frag[i].x[j] = 0.f;
+                p_frag[i].x[j] = __float2bfloat16(0.f);
+            }
+#pragma unroll
+            for (int kt = 0; kt < 8; ++kt) {
+                wmma::load_matrix_sync(k_frag, sK + (16 * i) * PADDED_D + kt * 16, PADDED_D);
+                wmma::mma_sync(s_frag[i], q_frag[kt], k_frag, s_frag[i]);
+            }
+#pragma unroll
+            for (int j = 0; j < 8; ++j) s_frag[i].x[j] *= scale;
+            if (warp == 0) {
+#pragma unroll
+                for (int j = 0; j < 8; ++j) {
+                    const int rr = ((j & 2) ? 8 : 0) + lane / 4;
+                    const int cc = 2 * (lane % 4) + (j & 1) + ((j & 4) ? 8 : 0);
+                    s2_out[(rr * 64 + 16 * i + cc)] = s_frag[i].x[j];
+                }
+            }
+            float tm0 = fmaxf(fmaxf(s_frag[i].x[0], s_frag[i].x[1]),
+                              fmaxf(s_frag[i].x[4], s_frag[i].x[5]));
+            float tm1 = fmaxf(fmaxf(s_frag[i].x[2], s_frag[i].x[3]),
+                              fmaxf(s_frag[i].x[6], s_frag[i].x[7]));
+            tm0 = warp_max4(tm0);
+            tm1 = warp_max4(tm1);
+            const float mn0 = fmaxf(m_prev[0], tm0);
+            const float mn1 = fmaxf(m_prev[1], tm1);
+            const float corr0 = __expf(m_prev[0] - mn0);
+            const float corr1 = __expf(m_prev[1] - mn1);
+#pragma unroll
+            for (int o = 0; o < 8; ++o) {
+#pragma unroll
+                for (int j = 0; j < 8; ++j)
+                    o_frag[o].x[j] *= ((j & 2) ? corr1 : corr0);
+            }
+            float ps0 = 0.f, ps1 = 0.f;
+#pragma unroll
+            for (int j = 0; j < 8; ++j) {
+                const float p = __expf(s_frag[i].x[j] - ((j & 2) ? mn1 : mn0));
+                s_frag[i].x[j] = p;
+                if (j & 2) ps1 += p; else ps0 += p;
+            }
+            ps0 = warp_sum4(ps0);
+            ps1 = warp_sum4(ps1);
+            l_prev[0] = l_prev[0] * corr0 + ps0;
+            l_prev[1] = l_prev[1] * corr1 + ps1;
+            m_prev[0] = mn0;
+            m_prev[1] = mn1;
+#pragma unroll
+            for (int j = 0; j < 8; ++j)
+                p_frag[i].x[j] = __float2bfloat16(s_frag[i].x[j]);
+        }
+
+#pragma unroll
+        for (int ot8 = 0; ot8 < 8; ++ot8) {
+#pragma unroll
+            for (int kc = 0; kc < 4; ++kc) {
+                wmma::load_matrix_sync(v_frag, sV + (16 * kc) * PADDED_D + ot8 * 16, PADDED_D);
+                wmma::mma_sync(o_frag[ot8], p_frag[kc], v_frag, o_frag[ot8]);
+            }
+        }
+        __syncthreads();
+    }
+
+    if (warp == 0) {
+        if (threadIdx.x == 30) {
+            printf("[lane30] m_prev=(%.4f, %.4f) l_prev=(%.4f, %.4f) "
+                   "p_frag[1].x[4]=%f p_frag[1].x[5]=%f p_frag[0].x[4]=%f\n",
+                   m_prev[0], m_prev[1], l_prev[0], l_prev[1],
+                   __bfloat162float(p_frag[1].x[4]),
+                   __bfloat162float(p_frag[1].x[5]),
+                   __bfloat162float(p_frag[0].x[4]));
+        }
+#pragma unroll
+        for (int i = 0; i < 4; ++i) {
+#pragma unroll
+            for (int j = 0; j < 8; ++j) {
+                const int rr = ((j & 2) ? 8 : 0) + lane / 4;
+                const int cc = 2 * (lane % 4) + (j & 1) + ((j & 4) ? 8 : 0);
+                p_out[rr * 64 + 16 * i + cc] = __bfloat162float(p_frag[i].x[j]);
+            }
+        }
+#pragma unroll
+        for (int ot8 = 0; ot8 < 8; ++ot8) {
+            const int d0 = ot8 * 16;
+#pragma unroll
+            for (int j = 0; j < 8; ++j) {
+                const int rr = ((j & 2) ? 8 : 0) + lane / 4;
+                const int cc = 2 * (lane % 4) + (j & 1) + ((j & 4) ? 8 : 0);
+                o_out[rr * HEAD_DIM + d0 + cc] = o_frag[ot8].x[j];
+            }
+        }
+        l_out[lane / 4] = l_prev[0];
+        l_out[8 + lane / 4] = l_prev[1];
+        m_out[lane / 4] = m_prev[0];
+        m_out[8 + lane / 4] = m_prev[1];
+    }
+}
