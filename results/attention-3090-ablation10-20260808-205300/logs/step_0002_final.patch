--- /dev/null
+++ b/probe_layout.cu
@@ -0,0 +1,48 @@
+// Precise probe: A[16x16] row-major with A[r][c] = r*16+c; B = identity.
+// C = A*I = A. Dump a_frag.x[j] (value r*16+c reveals semantic (r,c) of the
+// matrix_a fragment) and c_frag.x[j] (accumulator positions).
+#include <cstdio>
+#include <cuda_bf16.h>
+#include <mma.h>
+
+using namespace nvcuda;
+
+__global__ void probe(float* a_out, float* c_out) {
+    wmma::fragment<wmma::matrix_a, 16, 16, 16, __nv_bfloat16, wmma::row_major> a_frag;
+    wmma::fragment<wmma::matrix_b, 16, 16, 16, __nv_bfloat16, wmma::row_major> b_frag;
+    wmma::fragment<wmma::accumulator, 16, 16, 16, float> c_frag;
+
+    __shared__ __nv_bfloat16 sA[256], sB[256];
+    for (int i = threadIdx.x; i < 256; i += 32) {
+        int r = i / 16, c = i % 16;
+        sA[i] = __float2bfloat16((float)(r * 16 + c));
+        sB[i] = __float2bfloat16((r == c) ? 1.0f : 0.0f);
+    }
+    __syncthreads();
+    wmma::load_matrix_sync(a_frag, sA, 16);
+    wmma::load_matrix_sync(b_frag, sB, 16);
+    wmma::fill_fragment(c_frag, 0.0f);
+    wmma::mma_sync(c_frag, a_frag, b_frag, c_frag);
+
+    for (int j = 0; j < 8; ++j) {
+        a_out[threadIdx.x * 8 + j] = __bfloat162float(a_frag.x[j]);
+        c_out[threadIdx.x * 8 + j] = c_frag.x[j];
+    }
+}
+
+int main() {
+    float *ao, *co;
+    cudaMallocManaged(&ao, 32 * 8 * sizeof(float));
+    cudaMallocManaged(&co, 32 * 8 * sizeof(float));
+    probe<<<1, 32>>>(ao, co);
+    cudaDeviceSynchronize();
+    for (int t = 0; t < 32; ++t) {
+        printf("tid %2d A:", t);
+        for (int j = 0; j < 8; ++j) { int v = (int)ao[t * 8 + j]; printf(" j%d=(%2d,%2d)", j, v / 16, v % 16); }
+        printf("   C:");
+        for (int j = 0; j < 8; ++j) { int v = (int)co[t * 8 + j]; printf(" j%d=(%2d,%2d)", j, v / 16, v % 16); }
+        printf("\n");
+    }
+    cudaFree(ao); cudaFree(co);
+    return 0;
+}
