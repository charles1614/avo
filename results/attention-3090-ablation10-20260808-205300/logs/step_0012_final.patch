diff --git a/dbg_min.cu b/dbg_min.cu
new file mode 100644
index 0000000..5020924
--- /dev/null
+++ b/dbg_min.cu
@@ -0,0 +1,52 @@
+#include <cuda_fp16.h>
+#include <cstdio>
+#include <cstdint>
+#include <vector>
+using namespace std;
+
+__device__ __forceinline__ void cp16(void* smem, const void* gmem) {
+    uint32_t s = static_cast<uint32_t>(__cvta_generic_to_shared(smem));
+    asm volatile("cp.async.cg.shared.global [%0], [%1], 16;\n" :: "r"(s), "l"(gmem));
+}
+__device__ __forceinline__ void commit() { asm volatile("cp.async.commit_group;\n"); }
+template<int N> __device__ __forceinline__ void wait() { asm volatile("cp.async.wait_group %0;\n" :: "n"(N)); }
+
+// 16 threads; each copies one 16B chunk (8 halfs) per tile.
+__global__ void tk(const __half* src, float* dst, int ntiles) {
+    __shared__ __half buf[2][128];
+    const int t = threadIdx.x;  // 16 threads
+    cp16(&buf[0][t * 8], src + t * 8);
+    commit();
+    for (int nt = 0; nt < ntiles; ++nt) {
+        if (nt + 1 < ntiles) {
+            cp16(&buf[(nt + 1) & 1][t * 8], src + (nt + 1) * 128 + t * 8);
+            commit();
+            wait<1>();
+        } else {
+            wait<0>();
+        }
+        __syncthreads();
+        for (int j = 0; j < 8; ++j) dst[nt * 128 + t * 8 + j] = (float)buf[nt & 1][t * 8 + j];
+        __syncthreads();
+    }
+}
+
+int main() {
+    const int ntiles = 8, N = ntiles * 128;
+    __half* src; cudaMalloc(&src, N * 2);
+    float* dst; cudaMalloc(&dst, N * 4);
+    vector<__half> hsrc(N);
+    for (int i = 0; i < N; ++i) hsrc[i] = __float2half((i + 1) * 0.5f);
+    cudaMemcpy(src, hsrc.data(), N * 2, cudaMemcpyHostToDevice);
+    tk<<<1, 16>>>(src, dst, ntiles);
+    cudaDeviceSynchronize();
+    vector<float> hdst(N);
+    cudaMemcpy(&hdst[0], dst, N * 4, cudaMemcpyDeviceToHost);
+    int bad = 0;
+    for (int i = 0; i < N; ++i) {
+        float exp = (i + 1) * 0.5f;
+        if (hdst[i] != exp) { if (bad < 10) printf("i=%d got %f exp %f\n", i, hdst[i], exp); ++bad; }
+    }
+    printf("bad=%d\n", bad);
+    return 0;
+}
diff --git a/dbg_test.py b/dbg_test.py
new file mode 100644
index 0000000..31d027f
--- /dev/null
+++ b/dbg_test.py
@@ -0,0 +1,30 @@
+import torch, math
+from torch.utils.cpp_extension import load_inline
+
+src = open('attention.cu').read()
+cpp = "torch::Tensor attention_forward(torch::Tensor q, torch::Tensor k, torch::Tensor v, bool causal);"
+mod = load_inline(name='attn_dbg3', cpp_sources=cpp, cuda_sources=src,
+                  functions=['attention_forward'], extra_cuda_cflags=['-O3'], verbose=False)
+
+torch.manual_seed(0)
+def ref(q, k, v, causal):
+    B, H, S, D = q.shape
+    scale = 1.0 / math.sqrt(D)
+    qf, kf, vf = q.float(), k.float(), v.float()
+    s = torch.einsum('bhqd,bhkd->bhqk', qf, kf) * scale
+    if causal:
+        mask = torch.tril(torch.ones(S, S, dtype=torch.bool, device=q.device))
+        s = s.masked_fill(~mask, float('-inf'))
+    p = torch.softmax(s, dim=-1)
+    return torch.einsum('bhqk,bhkd->bhqd', p, vf).bfloat16()
+
+S = 64
+q = torch.randn(1, 1, S, 128, dtype=torch.bfloat16, device='cuda')
+k = torch.randn(1, 1, S, 128, dtype=torch.bfloat16, device='cuda')
+v = torch.randn(1, 1, S, 128, dtype=torch.bfloat16, device='cuda')
+o = mod.attention_forward(q, k, v, False)
+r = ref(q, k, v, False)
+err = (o.float() - r.float()).abs()
+per_row = err.max(dim=-1).values[0, 0]
+for i in range(S):
+    print(f"row {i:3d} err {per_row[i].item():.4f}")
