+// ---------------------------------------------------------------------------
+// Load a [rows][128] bf16 tile from gmem into swizzled shared via cp.async.
+// 16B chunks, row-major: chunk c -> row c/8, cols (c%8)*8. rows_hi exclusive
+// upper bound (rows >= rows_hi are skipped).
+__device__ __forceinline__ void cp_async_tile(
+    __nv_bfloat16* sdest, const __nv_bfloat16* gsrc, int rows,
+    int n_chunks, int tid, int rows_hi)
+{
+#pragma unroll
+    for (int i = 0; i < n_chunks; ++i) {
+        const int c = i * NUM_THREADS + tid;
+        const int row = c >> 3;
+        const int col8 = (c & 7) * 8;
+        if (row < rows_hi) {
+            cp_async16(sdest + swizzle_off(row, col8) / 2,
+                       gsrc + (long long)row * HEAD_DIM + col8);
+        }
+    }
+}
 
