+// ---------------------------------------------------------------------------
+// Shared memory swizzle: row-major [rows][128] bf16 tile, 256B rows.
+// Permute the eight 16B granules of each 128B segment by (row & 7) so that
+// ldmatrix's 8 row addresses (8 consecutive rows, fixed 16B window) hit
+// distinct banks. Invertible (XOR), preserves 16B alignment.
+__device__ __forceinline__ int swizzle_off(int row, int col) {
+    const int byte = row * (HEAD_DIM * 2) + col * 2;
+    const int gran = (byte >> 4) & 7;
+    const int sw = (byte >> 4) ^ (row & 7);
+    return (byte & ~0x70) | (sw << 4) | (byte & 0x0F);
+}
