+// Standalone full-pipeline probe: one block, 4 warps, BLOCK_M=64, BLOCK_N=64,
+// random-ish Q/K/V in global, computes attention via the wmma path and
+// compares against an in-kernel scalar reference. Prints first mismatches.
+#include <cuda_bf16.h>
+#include <mma.h>
+#include <cstdio>
+#include <math.h>
+#include <stdint.h>
+using namespace nvcuda;
+
+constexpr int BLOCK_M = 64, BLOCK_N = 64, HEAD_DIM = 128;
+constexpr int NUM_WARPS = 4, NUM_THREADS = 128;
+constexpr float LOG2E = 1.4426950408889634f;
+
+__device__ __forceinline__ float exp2_approx(float x) {
+    float y; asm("ex2.approx.f32 %0, %1;" : "=f"(y) : "f"(x)); return y;
+}
+__device__ __forceinline__ uint32_t pack2bf16(float lo, float hi) {
+    union { __nv_bfloat16 h[2]; uint32_t u; } v;
+    v.h[0] = __float2bfloat16(lo); v.h[1] = __float2bfloat16(hi); return v.u;
+}
+
+__global__ void probe_pipeline(
+    const __nv_bfloat16* __restrict__ q,
+    const __nv_bfloat16* __restrict__ k,
+    const __nv_bfloat16* __restrict__ v,
+    __nv_bfloat16* __restrict__ out,
+    int seq_len, float scale_log2, bool causal, int* nbad)
+{
+    __shared__ __nv_bfloat16 sK[BLOCK_N][HEAD_DIM];
+    __shared__ __nv_bfloat16 sV[BLOCK_N][HEAD_DIM];
+    const int m_tile = blockIdx.x, bh = blockIdx.y;
+    const int warp = threadIdx.x / 32, lane = threadIdx.x % 32;
+    const int gid = lane / 4, tig = lane % 4;
+    const long long base = (long long)bh * seq_len * HEAD_DIM;
+    const int grow0 = m_tile * BLOCK_M + warp * 16;
+
+    wmma::fragment<wmma::matrix_a, 16, 16, 16, __nv_bfloat16, wmma::row_major> qf[8];
+#pragma unroll
+    for (int j = 0; j < 8; ++j)
+        wmma::load_matrix_sync(qf[j], q + base + (long long)grow0 * HEAD_DIM + j * 16, HEAD_DIM);
+
+    wmma::fragment<wmma::accumulator, 16, 16, 16, float> acc_o[8];
+#pragma unroll
+    for (int j = 0; j < 8; ++j) wmma::fill_fragment(acc_o[j], 0.0f);
+    float m2[2] = {-INFINITY, -INFINITY}, l[2] = {0.f, 0.f};
+
+    const int row_hi = min(m_tile * BLOCK_M + BLOCK_M - 1, seq_len - 1);
+    int n_tiles = (seq_len + BLOCK_N - 1) / BLOCK_N;
+    if (causal) n_tiles = min(n_tiles, row_hi / BLOCK_N + 1);
+    if (grow0 >= seq_len) n_tiles = 0;
+
+    for (int nt = 0; nt < n_tiles; ++nt) {
+        {
+            const int nchunk = BLOCK_N * HEAD_DIM / 8;
+            const uint4 zero = make_uint4(0, 0, 0, 0);
+            for (int i = threadIdx.x; i < nchunk; i += NUM_THREADS) {
+                const int r = i / 16, u = i % 16;
+                const int grow_kv = nt * BLOCK_N + r;
+                if (grow_kv < seq_len) {
+                    *reinterpret_cast<uint4*>(&sK[r][u * 8]) =
+                        *reinterpret_cast<const uint4*>(k + base + (long long)grow_kv * HEAD_DIM + u * 8);
+                    *reinterpret_cast<uint4*>(&sV[r][u * 8]) =
+                        *reinterpret_cast<const uint4*>(v + base + (long long)grow_kv * HEAD_DIM + u * 8);
+                } else {
+                    *reinterpret_cast<uint4*>(&sK[r][u * 8]) = zero;
+                    *reinterpret_cast<uint4*>(&sV[r][u * 8]) = zero;
+                }
+            }
+        }
+        __syncthreads();
+
+        wmma::fragment<wmma::matrix_b, 16, 16, 16, __nv_bfloat16, wmma::col_major> kf[4];
+        wmma::fragment<wmma::accumulator, 16, 16, 16, float> s_acc[4];
+#pragma unroll
+        for (int g = 0; g < 4; ++g) {
+            wmma::load_matrix_sync(kf[g], &sK[g * 16][0], HEAD_DIM);
+            wmma::fill_fragment(s_acc[g], 0.0f);
+        }
+#pragma unroll
+        for (int g = 0; g < 4; ++g)
+#pragma unroll
+            for (int j = 0; j < 8; ++j)
+                wmma::mma_sync(s_acc[g], qf[j], kf[g], s_acc[g]);
+
+        float mt[2] = {-INFINITY, -INFINITY};
+#pragma unroll
+        for (int g = 0; g < 4; ++g)
+#pragma unroll
+            for (int e = 0; e < 8; ++e)
+                mt[(e % 4) / 2] = fmaxf(mt[(e % 4) / 2], s_acc[g].x[e] * scale_log2);
+#pragma unroll
+        for (int off = 2; off > 0; off >>= 1) {
+            mt[0] = fmaxf(mt[0], __shfl_xor_sync(0xffffffffu, mt[0], off));
+            mt[1] = fmaxf(mt[1], __shfl_xor_sync(0xffffffffu, mt[1], off));
+        }
+#pragma unroll
+        for (int r = 0; r < 2; ++r) {
+            const float m_new = fmaxf(m2[r], mt[r]);
+            const float corr = exp2_approx(m2[r] - m_new);
+            l[r] *= corr;
+            m2[r] = m_new;
+#pragma unroll
+            for (int j = 0; j < 8; ++j)
+#pragma unroll
+                for (int e = 0; e < 8; ++e)
+                    if ((e % 4) / 2 == r) acc_o[j].x[e] *= corr;
+        }
+
+        wmma::fragment<wmma::matrix_b, 16, 16, 16, __nv_bfloat16, wmma::col_major> vf[8];
+#pragma unroll
+        for (int j = 0; j < 8; ++j)
+            wmma::load_matrix_sync(vf[j], &sV[0][j * 16], HEAD_DIM);
+
+#pragma unroll
+        for (int g = 0; g < 4; ++g) {
+            wmma::fragment<wmma::matrix_a, 16, 16, 16, __nv_bfloat16, wmma::row_major> pf;
+#pragma unroll
+            for (int e = 0; e < 8; ++e) {
+                const int row = grow0 + gid + 8 * ((e % 4) / 2);
+                const int col = nt * BLOCK_N + 16 * g + 2 * tig + 8 * (e / 4);
+                const bool valid = (col < seq_len) && (!causal || col <= row);
+                const float s = s_acc[g].x[e] * scale_log2;
+                const float p = valid ? exp2_approx(s - m2[(e % 4) / 2]) : 0.f;
+                pf.x[e] = __float2bfloat16(p);
+                l[(e % 4) / 2] += p;
+            }
+#pragma unroll
+            for (int j = 0; j < 8; ++j)
+                wmma::mma_sync(acc_o[j], pf, vf[j], acc_o[j]);
+        }
+        __syncthreads();
+    }
+
+    // epilogue: scale and store to global directly (no shared staging here)
+    float inv_l[2];
+#pragma unroll
+    for (int r = 0; r < 2; ++r) inv_l[r] = (l[r] > 0.f) ? 1.f / l[r] : 0.f;
+#pragma unroll
+    for (int j = 0; j < 8; ++j) {
+        const int c0 = j * 16 + 2 * tig;
+#pragma unroll
+        for (int e = 0; e < 8; ++e) acc_o[j].x[e] *= inv_l[(e % 4) / 2];
+        *reinterpret_cast<uint32_t*>(&out[base + (long long)(grow0 + gid) * HEAD_DIM + c0]) =
+            pack2bf16(acc_o[j].x[0], acc_o[j].x[1]);
+        *reinterpret_cast<uint32_t*>(&out[base + (long long)(grow0 + gid + 8) * HEAD_DIM + c0]) =
+            pack2bf16(acc_o[j].x[2], acc_o[j].x[3]);
+        *reinterpret_cast<uint32_t*>(&out[base + (long long)(grow0 + gid) * HEAD_DIM + c0 + 8]) =
+            pack2bf16(acc_o[j].x[4], acc_o[j].x[5]);
+        *reinterpret_cast<uint32_t*>(&out[base + (long long)(grow0 + gid + 8) * HEAD_DIM + c0 + 8]) =
+            pack2bf16(acc_o[j].x[6], acc_o[j].x[7]);
+    }
+}
+
+int main() {
+    const int S = 64;
+    __nv_bfloat16 *q, *k, *v, *out;
+    int* nbad;
+    cudaMallocManaged(&q, sizeof(__nv_bfloat16) * S * HEAD_DIM);
+    cudaMallocManaged(&k, sizeof(__nv_bfloat16) * S * HEAD_DIM);
+    cudaMallocManaged(&v, sizeof(__nv_bfloat16) * S * HEAD_DIM);
+    cudaMallocManaged(&out, sizeof(__nv_bfloat16) * S * HEAD_DIM);
+    cudaMallocManaged(&nbad, sizeof(int));
+    // deterministic pseudo-random data
+    srand(42);
+    for (int i = 0; i < S * HEAD_DIM; ++i) {
+        q[i] = __float2bfloat16(((float)rand() / RAND_MAX - 0.5f) * 2.0f);
+        k[i] = __float2bfloat16(((float)rand() / RAND_MAX - 0.5f) * 2.0f);
+        v[i] = __float2bfloat16(((float)rand() / RAND_MAX - 0.5f) * 2.0f);
+    }
+    const float scale = 1.0f / sqrtf(HEAD_DIM);
+    probe_pipeline<<<1, NUM_THREADS>>>(q, k, v, out, S, scale * LOG2E, false, nbad);
+    cudaDeviceSynchronize();
+
+    // scalar reference
+    float worst = 0.f; int wr = -1, wc = -1;
+    for (int m = 0; m < S; ++m) {
+        float num[HEAD_DIM] = {0}, den = 0, mx = -INFINITY;
+        for (int c = 0; c < S; ++c) {
+            float s = 0;
+            for (int d = 0; d < HEAD_DIM; ++d) s += __bfloat162float(q[m * HEAD_DIM + d]) * __bfloat162float(k[c * HEAD_DIM + d]);
+            s *= scale;
+            mx = fmaxf(mx, s);
+        }
+        for (int c = 0; c < S; ++c) {
+            float s = 0;
+            for (int d = 0; d < HEAD_DIM; ++d) s += __bfloat162float(q[m * HEAD_DIM + d]) * __bfloat162float(k[c * HEAD_DIM + d]);
+            s *= scale;
+            float p = expf(s - mx);
+            den += p;
+            for (int d = 0; d < HEAD_DIM; ++d) num[d] += p * __bfloat162float(v[c * HEAD_DIM + d]);
+        }
+        for (int d = 0; d < HEAD_DIM; ++d) {
+            float got = __bfloat162float(out[m * HEAD_DIM + d]);
+            float exp = num[d] / den;
+            float err = fabsf(got - exp);
+            if (err > worst) { worst = err; wr = m; wc = d; }
+        }
+    }
+    printf("worst err = %f at row %d col %d\n", worst, wr, wc);
+    // print a few rows: got vs expected
+    for (int m = 0; m < 8; ++m) {
+        float num[HEAD_DIM] = {0}, den = 0, mx = -INFINITY;
+        for (int c = 0; c < S; ++c) {
+            float s = 0;
+            for (int d = 0; d < HEAD_DIM; ++d) s += __bfloat162float(q[m * HEAD_DIM + d]) * __bfloat162float(k[c * HEAD_DIM + d]);
+            s *= scale; mx = fmaxf(mx, s);
+        }
+        for (int c = 0; c < S; ++c) {
+            float s = 0;
+            for (int d = 0; d < HEAD_DIM; ++d) s += __bfloat162float(q[m * HEAD_DIM + d]) * __bfloat162float(k[c * HEAD_DIM + d]);
+            s *= scale;
+            float p = expf(s - mx); den += p;
+            for (int d = 0; d < HEAD_DIM; ++d) num[d] += p * __bfloat162float(v[c * HEAD_DIM + d]);
+        }
+        printf("row %d: got %.4f exp %.4f | got %.4f exp %.4f | got %.4f exp %.4f\n",
+               m,
+               __bfloat162float(out[m * HEAD_DIM + 0]), num[0] / den,
+               __bfloat162float(out[m * HEAD_DIM + 1]), num[1] / den,
+               __bfloat162float(out[m * HEAD_DIM + 63]), num[63] / den);
+    }
+    return 0;
+}
diff --git a/probe_struct.cu b/probe_struct.cu
new file mode 100644
index 0000000..75dea8f
--- /dev/null
+++ b/probe_struct.cu
@@ -0,0 +1,211 @@
+// Structured probe: Q = K = V = identity. Expected: S[m][c] = scale*delta(m,c),
+// O[m][d] = delta(m,d). Dumps S fragment (per warp 0) and O to global for
+// inspection. Also computes S via wmma and prints the full 16x64 S matrix.
+#include <cuda_bf16.h>
+#include <mma.h>
+#include <cstdio>
+#include <math.h>
+#include <stdint.h>
+using namespace nvcuda;
+
+constexpr int BLOCK_M = 64, BLOCK_N = 64, HEAD_DIM = 128;
+constexpr int NUM_THREADS = 128;
+constexpr float LOG2E = 1.4426950408889634f;
+
+__device__ __forceinline__ float exp2_approx(float x) {
+    float y; asm("ex2.approx.f32 %0, %1;" : "=f"(y) : "f"(x)); return y;
+}
+__device__ __forceinline__ uint32_t pack2bf16(float lo, float hi) {
+    union { __nv_bfloat16 h[2]; uint32_t u; } v;
+    v.h[0] = __float2bfloat16(lo); v.h[1] = __float2bfloat16(hi); return v.u;
+}
+
+__global__ void probe_struct(
+    const __nv_bfloat16* __restrict__ q,
+    const __nv_bfloat16* __restrict__ k,
+    const __nv_bfloat16* __restrict__ v,
+    __nv_bfloat16* __restrict__ out,
+    float* s_dump, float* o_dump, int seq_len, float scale_log2)
+{
+    __shared__ __nv_bfloat16 sK[BLOCK_N][HEAD_DIM];
+    __shared__ __nv_bfloat16 sV[BLOCK_N][HEAD_DIM];
+    const int warp = threadIdx.x / 32, lane = threadIdx.x % 32;
+    const int gid = lane / 4, tig = lane % 4;
+    const int grow0 = warp * 16;
+
+    wmma::fragment<wmma::matrix_a, 16, 16, 16, __nv_bfloat16, wmma::row_major> qf[8];
+#pragma unroll
+    for (int j = 0; j < 8; ++j)
+        wmma::load_matrix_sync(qf[j], q + (long long)grow0 * HEAD_DIM + j * 16, HEAD_DIM);
+    wmma::fragment<wmma::accumulator, 16, 16, 16, float> acc_o[8];
+#pragma unroll
+    for (int j = 0; j < 8; ++j) wmma::fill_fragment(acc_o[j], 0.0f);
+    float m2[2] = {-INFINITY, -INFINITY}, l[2] = {0.f, 0.f};
+
+    int n_tiles = (seq_len + BLOCK_N - 1) / BLOCK_N;
+    for (int nt = 0; nt < n_tiles; ++nt) {
+        {
+            const int nchunk = BLOCK_N * HEAD_DIM / 8;
+            const uint4 zero = make_uint4(0, 0, 0, 0);
+            for (int i = threadIdx.x; i < nchunk; i += NUM_THREADS) {
+                const int r = i / 16, u = i % 16;
+                const int grow_kv = nt * BLOCK_N + r;
+                if (grow_kv < seq_len) {
+                    *reinterpret_cast<uint4*>(&sK[r][u * 8]) =
+                        *reinterpret_cast<const uint4*>(k + (long long)grow_kv * HEAD_DIM + u * 8);
+                    *reinterpret_cast<uint4*>(&sV[r][u * 8]) =
+                        *reinterpret_cast<const uint4*>(v + (long long)grow_kv * HEAD_DIM + u * 8);
+                } else {
+                    *reinterpret_cast<uint4*>(&sK[r][u * 8]) = zero;
+                    *reinterpret_cast<uint4*>(&sV[r][u * 8]) = zero;
+                }
+            }
+        }
+        __syncthreads();
+
+        wmma::fragment<wmma::matrix_b, 16, 16, 16, __nv_bfloat16, wmma::col_major> kf[4];
+        wmma::fragment<wmma::accumulator, 16, 16, 16, float> s_acc[4];
+#pragma unroll
+        for (int g = 0; g < 4; ++g) {
+            wmma::load_matrix_sync(kf[g], &sK[g * 16][0], HEAD_DIM);
+            wmma::fill_fragment(s_acc[g], 0.0f);
+        }
+#pragma unroll
+        for (int g = 0; g < 4; ++g)
+#pragma unroll
+            for (int j = 0; j < 8; ++j)
+                wmma::mma_sync(s_acc[g], qf[j], kf[g], s_acc[g]);
+
+        if (warp == 0) {  // dump S: 16 rows x 64 cols
+#pragma unroll
+            for (int g = 0; g < 4; ++g)
+#pragma unroll
+                for (int e = 0; e < 8; ++e) {
+                    const int row = gid + 8 * ((e % 4) / 2);
+                    const int col = 16 * g + 2 * tig + 8 * (e / 4);
+                    s_dump[row * 64 + col] = s_acc[g].x[e];
+                }
+        }
+
+        float mt[2] = {-INFINITY, -INFINITY};
+#pragma unroll
+        for (int g = 0; g < 4; ++g)
+#pragma unroll
+            for (int e = 0; e < 8; ++e)
+                mt[(e % 4) / 2] = fmaxf(mt[(e % 4) / 2], s_acc[g].x[e] * scale_log2);
+#pragma unroll
+        for (int off = 2; off > 0; off >>= 1) {
+            mt[0] = fmaxf(mt[0], __shfl_xor_sync(0xffffffffu, mt[0], off));
+            mt[1] = fmaxf(mt[1], __shfl_xor_sync(0xffffffffu, mt[1], off));
+        }
+#pragma unroll
+        for (int r = 0; r < 2; ++r) {
+            const float m_new = fmaxf(m2[r], mt[r]);
+            const float corr = exp2_approx(m2[r] - m_new);
+            l[r] *= corr;
+            m2[r] = m_new;
+#pragma unroll
+            for (int j = 0; j < 8; ++j)
+#pragma unroll
+                for (int e = 0; e < 8; ++e)
+                    if ((e % 4) / 2 == r) acc_o[j].x[e] *= corr;
+        }
+
+        wmma::fragment<wmma::matrix_b, 16, 16, 16, __nv_bfloat16, wmma::col_major> vf[8];
+#pragma unroll
+        for (int j = 0; j < 8; ++j)
+            wmma::load_matrix_sync(vf[j], &sV[0][j * 16], HEAD_DIM);
+
+#pragma unroll
+        for (int g = 0; g < 4; ++g) {
+            wmma::fragment<wmma::matrix_a, 16, 16, 16, __nv_bfloat16, wmma::row_major> pf;
+#pragma unroll
+            for (int e = 0; e < 8; ++e) {
+                const int row = grow0 + gid + 8 * ((e % 4) / 2);
+                const int col = nt * BLOCK_N + 16 * g + 2 * tig + 8 * (e / 4);
+                const bool valid = (col < seq_len);
+                const float s = s_acc[g].x[e] * scale_log2;
+                const float p = valid ? exp2_approx(s - m2[(e % 4) / 2]) : 0.f;
+                pf.x[e] = __float2bfloat16(p);
+                l[(e % 4) / 2] += p;
+            }
+#pragma unroll
+            for (int j = 0; j < 8; ++j)
+                wmma::mma_sync(acc_o[j], pf, vf[j], acc_o[j]);
+        }
+        __syncthreads();
+    }
+
+    if (warp == 0) {  // dump O (raw, unscaled)
+#pragma unroll
+        for (int j = 0; j < 8; ++j)
+#pragma unroll
+            for (int e = 0; e < 8; ++e) {
+                const int row = gid + 8 * ((e % 4) / 2);
+                const int col = j * 16 + 2 * tig + 8 * (e / 4);
+                o_dump[row * 128 + col] = acc_o[j].x[e];
+            }
+    }
+    float inv_l[2];
+#pragma unroll
+    for (int r = 0; r < 2; ++r) inv_l[r] = (l[r] > 0.f) ? 1.f / l[r] : 0.f;
+#pragma unroll
+    for (int j = 0; j < 8; ++j) {
+        const int c0 = j * 16 + 2 * tig;
+#pragma unroll
+        for (int e = 0; e < 8; ++e) acc_o[j].x[e] *= inv_l[(e % 4) / 2];
+        *reinterpret_cast<uint32_t*>(&out[(long long)(grow0 + gid) * HEAD_DIM + c0]) =
+            pack2bf16(acc_o[j].x[0], acc_o[j].x[1]);
+        *reinterpret_cast<uint32_t*>(&out[(long long)(grow0 + gid + 8) * HEAD_DIM + c0]) =
+            pack2bf16(acc_o[j].x[2], acc_o[j].x[3]);
+        *reinterpret_cast<uint32_t*>(&out[(long long)(grow0 + gid) * HEAD_DIM + c0 + 8]) =
+            pack2bf16(acc_o[j].x[4], acc_o[j].x[5]);
+        *reinterpret_cast<uint32_t*>(&out[(long long)(grow0 + gid + 8) * HEAD_DIM + c0 + 8]) =
+            pack2bf16(acc_o[j].x[6], acc_o[j].x[7]);
+    }
+}
+
+int main() {
+    const int S = 64;
+    __nv_bfloat16 *q, *k, *v, *out;
+    float *s_dump, *o_dump;
+    cudaMallocManaged(&q, sizeof(__nv_bfloat16) * S * HEAD_DIM);
+    cudaMallocManaged(&k, sizeof(__nv_bfloat16) * S * HEAD_DIM);
+    cudaMallocManaged(&v, sizeof(__nv_bfloat16) * S * HEAD_DIM);
+    cudaMallocManaged(&out, sizeof(__nv_bfloat16) * S * HEAD_DIM);
+    cudaMallocManaged(&s_dump, sizeof(float) * 16 * 64);
+    cudaMallocManaged(&o_dump, sizeof(float) * 16 * 128);
+    for (int i = 0; i < S * HEAD_DIM; ++i) {
+        q[i] = __float2bfloat16(0.f);
+        k[i] = __float2bfloat16(0.f);
+        v[i] = __float2bfloat16(0.f);
+    }
+    for (int m = 0; m < S; ++m) {
+        q[m * HEAD_DIM + m] = __float2bfloat16(1.f);
+        k[m * HEAD_DIM + m] = __float2bfloat16(1.f);
+        v[m * HEAD_DIM + m] = __float2bfloat16(1.f);
+    }
+    const float scale = 1.0f / sqrtf(HEAD_DIM);
+    probe_struct<<<1, NUM_THREADS>>>(q, k, v, out, s_dump, o_dump, S, scale * LOG2E);
+    cudaDeviceSynchronize();
+
+    printf("S dump (rows 0..15, cols 0..63), values = S*scale_log2 domain raw:\n");
+    for (int r = 0; r < 16; ++r) {
+        printf("r%02d:", r);
+        for (int c = 0; c < 64; ++c) printf(" %6.3f", s_dump[r * 64 + c]);
+        printf("\n");
+    }
+    printf("\nO dump raw (rows 0..15, cols 0..127):\n");
+    for (int r = 0; r < 16; ++r) {
+        printf("r%02d:", r);
+        for (int c = 0; c < 128; ++c) printf(" %6.3f", o_dump[r * 128 + c]);
+        printf("\n");
+    }
+    printf("\nfinal out rows 0..15 (should be identity-ish):\n");
+    for (int r = 0; r < 16; ++r) {
+        printf("r%02d:", r);
+        for (int c = 0; c < 128; ++c) printf(" %5.2f", __bfloat162float(out[r * HEAD_DIM + c]));
+        printf("\n");
+    }
+    return 0;
+}
