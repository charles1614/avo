diff --git a/probe_layout.cu b/probe_layout.cu
new file mode 100644
index 0000000..2536e09
--- /dev/null
+++ b/probe_layout.cu
@@ -0,0 +1,40 @@
+// Standalone wmma layout probe (no torch): dumps matrix_a fragment layout and
+// accumulator layout for m16n16k16 bf16, and checks A == C layout claim.
+#include <cuda_bf16.h>
+#include <mma.h>
+#include <cstdio>
+using namespace nvcuda;
+
+__global__ void probe_layout() {
+    __shared__ __nv_bfloat16 sm[16][16];
+    __shared__ __nv_bfloat16 smB[16][16];  // col-major storage of B
+    int lane = threadIdx.x % 32;
+    int tid = threadIdx.x;
+    if (tid < 256) {
+        int i = tid / 16, j = tid % 16;
+        sm[i][j] = __float2bfloat16((float)(i * 16 + j));
+    }
+    if (tid < 256) {
+        int k = tid / 16, n = tid % 16;
+        smB[k][n] = __float2bfloat16((k == n) ? 1.0f : 0.0f);  // identity
+    }
+    __syncthreads();
+
+    wmma::fragment<wmma::matrix_a, 16, 16, 16, __nv_bfloat16, wmma::row_major> a;
+    wmma::load_matrix_sync(a, &sm[0][0], 16);
+    wmma::fragment<wmma::matrix_b, 16, 16, 16, __nv_bfloat16, wmma::col_major> b;
+    wmma::load_matrix_sync(b, &smB[0][0], 16);
+    wmma::fragment<wmma::accumulator, 16, 16, 16, float> c;
+    wmma::fill_fragment(c, 0.0f);
+    wmma::mma_sync(c, a, b, c);
+
+    for (int e = 0; e < 8; ++e)
+        printf("lane %2d e%d: A=%2d C=%2d\n", lane, e,
+               (int)__bfloat162float(a.x[e]), (int)c.x[e]);
+}
+
+int main() {
+    probe_layout<<<1, 32>>>();
+    cudaDeviceSynchronize();
+    return 0;
+}
