diff --git a/probe_layout.cu b/probe_layout.cu
new file mode 100644
index 0000000..df65099
--- /dev/null
+++ b/probe_layout.cu
@@ -0,0 +1,46 @@
+// Probe: ldmatrix mapping with CORRECT addressing (lane l supplies row l).
+#include <cstdio>
+#include <cstdint>
+#include <cuda_bf16.h>
+
+__device__ __forceinline__ uint32_t pack2(float lo, float hi) {
+    union { __nv_bfloat16 bf[2]; uint32_t u; } u;
+    u.bf[0] = __float2bfloat16(lo); u.bf[1] = __float2bfloat16(hi);
+    return u.u;
+}
+
+// Non-trans: 32 rows x 8 cols tile (4 stacked 8x8). T[row][col] = row*8+col (exact in bf16).
+__global__ void ldm_test() {
+    __shared__ __nv_bfloat16 T[32][8];
+    const int lane = threadIdx.x % 32;
+    for (int i = threadIdx.x; i < 256; i += 32) T[i/8][i%8] = __float2bfloat16((float)((i/8)*8 + (i%8)));
+    __syncthreads();
+    uint32_t r[4];
+    uint32_t saddr = (uint32_t)__cvta_generic_to_shared(&T[lane][0]);
+    asm volatile("ldmatrix.sync.aligned.m8n8.x4.shared.b16 {%0,%1,%2,%3}, [%4];\n"
+                 : "=r"(r[0]), "=r"(r[1]), "=r"(r[2]), "=r"(r[3]) : "r"(saddr));
+    printf("LDM  lane %2d: r0=(%u,%u) r1=(%u,%u) r2=(%u,%u) r3=(%u,%u)\n",
+           lane, r[0]&0xffff, r[0]>>16, r[1]&0xffff, r[1]>>16, r[2]&0xffff, r[2]>>16, r[3]&0xffff, r[3]>>16);
+}
+
+// Trans: 32 rows x 8 cols.
+__global__ void ldm_t_test() {
+    __shared__ __nv_bfloat16 T[32][8];
+    const int lane = threadIdx.x % 32;
+    for (int i = threadIdx.x; i < 256; i += 32) T[i/8][i%8] = __float2bfloat16((float)((i/8)*8 + (i%8)));
+    __syncthreads();
+    uint32_t r[4];
+    uint32_t saddr = (uint32_t)__cvta_generic_to_shared(&T[lane][0]);
+    asm volatile("ldmatrix.sync.aligned.m8n8.x4.trans.shared.b16 {%0,%1,%2,%3}, [%4];\n"
+                 : "=r"(r[0]), "=r"(r[1]), "=r"(r[2]), "=r"(r[3]) : "r"(saddr));
+    printf("LDMT lane %2d: r0=(%u,%u) r1=(%u,%u) r2=(%u,%u) r3=(%u,%u)\n",
+           lane, r[0]&0xffff, r[0]>>16, r[1]&0xffff, r[1]>>16, r[2]&0xffff, r[2]>>16, r[3]&0xffff, r[3]>>16);
+}
+
+int main() {
+    ldm_test<<<1, 32>>>();
+    cudaDeviceSynchronize();
+    ldm_t_test<<<1, 32>>>();
+    cudaDeviceSynchronize();
+    return 0;
+}
