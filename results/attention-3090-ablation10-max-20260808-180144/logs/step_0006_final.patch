diff --git a/scratch_test.py b/scratch_test.py
new file mode 100644
index 0000000..e33fc3c
--- /dev/null
+++ b/scratch_test.py
@@ -0,0 +1,40 @@
+import torch, time
+from torch.utils.cpp_extension import load
+m = load(name="attn_probe", sources=["attention.cu", "binding.cpp"],
+         extra_cuda_cflags=["-O3", "-arch=sm_86"], verbose=False)
+
+torch.manual_seed(0)
+dev = "cuda"
+
+def ref(q, k, v, causal):
+    B, H, S, D = q.shape
+    qf, kf, vf = q.float(), k.float(), v.float()
+    if kf.shape[1] != H:
+        kf = kf.repeat_interleave(H // kf.shape[1], dim=1)
+        vf = vf.repeat_interleave(H // vf.shape[1], dim=1)
+    scale = 1.0 / (D ** 0.5)
+    s = torch.einsum("bhqd,bhkd->bhqk", qf, kf) * scale
+    if causal:
+        mask = torch.tril(torch.ones(S, S, device=dev, dtype=torch.bool))
+        s = s.masked_fill(~mask, float("-inf"))
+    p = torch.softmax(s, dim=-1)
+    o = torch.einsum("bhqk,bhkd->bhqd", p, vf)
+    return o
+
+def run(B, H, S, D=128, causal=False, kv=None):
+    kv = kv or H
+    q = torch.randn(B, H, S, D, device=dev, dtype=torch.bfloat16)
+    k = torch.randn(B, kv, S, D, device=dev, dtype=torch.bfloat16)
+    v = torch.randn(B, kv, S, D, device=dev, dtype=torch.bfloat16)
+    o = m.attention_forward(q, k, v, causal)
+    r = ref(q, k, v, causal)
+    err = (o.float() - r).abs().max().item()
+    print(f"B={B} H={H} kv={kv} S={S} causal={causal}: err={err:.5f}")
+
+for S in (128, 1024, 4096):
+    run(2, 16, S, causal=False)
+    run(2, 16, S, causal=True)
+run(2, 16, 1024, causal=False, kv=4)
+run(2, 16, 1024, causal=True, kv=4)
+run(1, 16, 100, causal=False)
+run(1, 16, 100, causal=True)
