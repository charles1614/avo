diff --git a/debug_test.py b/debug_test.py
new file mode 100644
index 0000000..11ca29e
--- /dev/null
+++ b/debug_test.py
@@ -0,0 +1,54 @@
+import os, sys, time
+import torch
+from torch.utils.cpp_extension import load_inline
+
+src_cuda = open('attention.cu').read()
+src_cpp = open('binding.cpp').read()
+
+extra_flags = []
+if os.path.exists('build_flags.json'):
+    import json
+    extra_flags = json.load(open('build_flags.json')).get('extra_cuda_cflags', [])
+
+mod = load_inline(
+    name='attention',
+    cpp_sources=[src_cpp],
+    cuda_sources=[src_cuda],
+    with_cuda=True,
+    extra_cuda_cflags=['-gencode', 'arch=compute_86,code=sm_86'] + extra_flags,
+    verbose=False,
+)
+
+def ref_attn(q, k, v, causal):
+    B, H, S, D = q.shape
+    KVH = k.shape[1]
+    scale = D ** -0.5
+    qf = q.float(); kf = k.float(); vf = v.float()
+    out = torch.empty_like(qf)
+    for h in range(H):
+        kvh = h // (H // KVH)
+        scores = qf[:, h] @ kf[:, kvh].transpose(-1, -2) * scale
+        if causal:
+            mask = torch.tril(torch.ones(S, S, dtype=torch.bool, device=q.device))
+            scores = scores.masked_fill(~mask, float('-inf'))
+        p = torch.softmax(scores, dim=-1)
+        out[:, h] = p @ vf[:, kvh]
+    return out
+
+torch.manual_seed(0)
+dev = 'cuda'
+B, H, KVH, S, causal = 1, 1, 1, 8, False
+q = torch.randn(B, H, S, 128, device=dev, dtype=torch.bfloat16)
+k = torch.randn(B, KVH, S, 128, device=dev, dtype=torch.bfloat16)
+v = torch.randn(B, KVH, S, 128, device=dev, dtype=torch.bfloat16)
+out = mod.attention_forward(q, k, v, causal)
+ref = ref_attn(q, k, v, causal)
+print("out shape", out.shape)
+err = (out.float() - ref).abs()
+print("max err:", err.max().item())
+# print first 2 rows
+for r in range(2):
+    got = out.float()[0, 0, r, :8]
+    exp = ref[0, 0, r, :8]
+    print(f"row {r} got:", [f"{x:.4f}" for x in got.tolist()])
+    print(f"row {r} exp:", [f"{x:.4f}" for x in exp.tolist()])
