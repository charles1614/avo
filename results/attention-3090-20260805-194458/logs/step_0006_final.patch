index 0000000..4c43977
--- /dev/null
+++ b/probe_frag.cu
@@ -0,0 +1,53 @@
+// Probe: determine exact ldmatrix fragment layouts on sm_86.
+// Loads matrices with known values, prints per-lane register contents.
+#include <cuda_runtime.h>
+#include <cuda_bf16.h>
+#include <stdio.h>
+#include <stdint.h>
+
+__device__ __forceinline__ void ldmatrix(uint32_t* r, int n, bool trans, const void* p) {
+    uint32_t a = (uint32_t)__cvta_generic_to_shared(p);
+    if (n == 1 && !trans)
+        asm volatile("ldmatrix.sync.aligned.m8n8.x1.shared.b16 {%0}, [%1];\n" : "=r"(r[0]) : "r"(a));
+    else if (n == 2 && !trans)
+        asm volatile("ldmatrix.sync.aligned.m8n8.x2.shared.b16 {%0,%1}, [%2];\n" : "=r"(r[0]), "=r"(r[1]) : "r"(a));
+    else if (n == 4 && !trans)
+        asm volatile("ldmatrix.sync.aligned.m8n8.x4.shared.b16 {%0,%1,%2,%3}, [%4];\n"
+                     : "=r"(r[0]), "=r"(r[1]), "=r"(r[2]), "=r"(r[3]) : "r"(a));
+    else if (n == 1 && trans)
+        asm volatile("ldmatrix.sync.aligned.m8n8.x1.trans.shared.b16 {%0}, [%1];\n" : "=r"(r[0]) : "r"(a));
+    else if (n == 2 && trans)
+        asm volatile("ldmatrix.sync.aligned.m8n8.x2.trans.shared.b16 {%0,%1}, [%2];\n" : "=r"(r[0]), "=r"(r[1]) : "r"(a));
+    else if (n == 4 && trans)
+        asm volatile("ldmatrix.sync.aligned.m8n8.x4.trans.shared.b16 {%0,%1,%2,%3}, [%4];\n"
+                     : "=r"(r[0]), "=r"(r[1]), "=r"(r[2]), "=r"(r[3]) : "r"(a));
+}
+
+// fixed kernel that just prints, one matrix
+__global__ void probe1(const uint16_t* gM, uint32_t* gOut) {
+    __shared__ uint16_t sM[8][8];
+    int t = threadIdx.x;
+    for (int i = t; i < 64; i += 32) sM[i/8][i%8] = gM[i];
+    __syncthreads();
+    int lane = t % 32;
+    // x1: threads 0-7 provide row addresses; others dummy (copy of lane 0's address)
+    uint32_t addr = (uint32_t)__cvta_generic_to_shared(&sM[lane % 8][0]);
+    uint32_t r0, r1;
+    asm volatile("ldmatrix.sync.aligned.m8n8.x1.shared.b16 {%0}, [%1];\n" : "=r"(r0) : "r"(addr));
+    asm volatile("ldmatrix.sync.aligned.m8n8.x1.trans.shared.b16 {%0}, [%1];\n" : "=r"(r1) : "r"(addr));
+    uint16_t a0 = (uint16_t)(r0 & 0xffff), a1 = (uint16_t)(r0 >> 16);
+    uint16_t b0 = (uint16_t)(r1 & 0xffff), b1 = (uint16_t)(r1 >> 16);
+    if (lane < 16) printf("x1   lane %2d: r0=%d,%d  trans r0=%d,%d\n", lane, a0, a1, b0, b1);
+}
+
+int main() {
+    uint16_t hM[64];
+    for (int i = 0; i < 8; i++)
+        for (int j = 0; j < 8; j++) hM[i*8+j] = 1000 + i*10 + j;
+    uint16_t *dM; uint32_t *dOut;
+    cudaMalloc(&dM, 64*2); cudaMalloc(&dOut, 128*4);
+    cudaMemcpy(dM, hM, 64*2, cudaMemcpyHostToDevice);
+    probe1<<<1, 32>>>(dM, dOut);
+    cudaDeviceSynchronize();
+    return 0;
+}
