index 0000000..f7ef165
--- /dev/null
+++ b/probe3.cu
@@ -0,0 +1,46 @@
+// Probe 3: dump ldmatrix.x4.trans fragment for a 16x16 bf16 tile.
+// Tile value = n*16 + k (row n, col k), exact in bf16. Row stride 32 bytes.
+#include <cuda_bf16.h>
+#include <cstdio>
+#include <cstdint>
+
+__global__ void probe3_kernel(const __nv_bfloat16* K, uint32_t* out) {
+    __shared__ __align__(16) __nv_bfloat16 sK[16][16];
+    for (int i = threadIdx.x; i < 256; i += blockDim.x) sK[i / 16][i % 16] = K[i];
+    __syncthreads();
+    const int l = threadIdx.x % 32;
+    const char* base = reinterpret_cast<const char*>(&sK[0][0]);
+    uint32_t addr_off = static_cast<uint32_t>(__cvta_generic_to_shared(base));
+    // Correct address: lane l supplies address of row (l/4)%8 of matrix l/8.
+    int m = l / 8, row = (l / 4) % 8;
+    uint32_t addr = addr_off + (uint32_t)((m * 8 + row) * 32);
+    uint32_t r[4];
+    asm volatile("ldmatrix.sync.aligned.m8n8.x4.trans.shared.b16 {%0,%1,%2,%3}, [%4];\n"
+                 : "=r"(r[0]), "=r"(r[1]), "=r"(r[2]), "=r"(r[3]) : "r"(addr));
+    for (int i = 0; i < 4; ++i) out[l * 4 + i] = r[i];
+}
+
+int main() {
+    __nv_bfloat16* Kd; uint32_t* od;
+    cudaMalloc(&Kd, 256 * 2); cudaMalloc(&od, 128 * 4);
+    __nv_bfloat16 Kh[256];
+    for (int n = 0; n < 16; ++n)
+        for (int k = 0; k < 16; ++k) Kh[n * 16 + k] = __float2bfloat16((float)(n * 16 + k));
+    cudaMemcpy(Kd, Kh, 256 * 2, cudaMemcpyHostToDevice);
+    probe3_kernel<<<1, 32>>>(Kd, od);
+    cudaDeviceSynchronize();
+    uint32_t h[128];
+    cudaMemcpy(h, od, 128 * 4, cudaMemcpyDeviceToHost);
+    auto show = [](uint32_t v) {
+        __nv_bfloat16 blo = __ushort_as_bfloat16((unsigned short)(v & 0xffff));
+        __nv_bfloat16 bhi = __ushort_as_bfloat16((unsigned short)(v >> 16));
+        int flo = (int)__bfloat162float(blo), fhi = (int)__bfloat162float(bhi);
+        printf("(%d,%d)(%d,%d)", flo / 16, flo % 16, fhi / 16, fhi % 16);
+    };
+    for (int l = 0; l < 32; ++l) {
+        printf("lane %2d: ", l);
+        for (int i = 0; i < 4; ++i) show(h[l * 4 + i]);
+        printf("\n");
+    }
+    return 0;
+}
diff --git a/probe4.cu b/probe4.cu
new file mode 100644
index 0000000..e807ffc
--- /dev/null
+++ b/probe4.cu
@@ -0,0 +1,55 @@
+// Probe 4: ldmatrix.x4 plain and trans, correct addr formula row=l%8, matrix=l/8.
+// Tile: 16x16 bf16, value = row*16+col, row stride 32B.
+#include <cuda_bf16.h>
+#include <cstdio>
+#include <cstdint>
+
+__global__ void probe4_kernel(const __nv_bfloat16* K, uint32_t* op, uint32_t* ot) {
+    __shared__ __align__(16) __nv_bfloat16 sK[16][16];
+    for (int i = threadIdx.x; i < 256; i += blockDim.x) sK[i / 16][i % 16] = K[i];
+    __syncthreads();
+    const int l = threadIdx.x % 32;
+    const char* base = reinterpret_cast<const char*>(&sK[0][0]);
+    uint32_t addr_off = static_cast<uint32_t>(__cvta_generic_to_shared(base));
+    int m = l / 8, row = l % 8;
+    uint32_t addr = addr_off + (uint32_t)((m * 8 + row) * 32);
+    uint32_t rp[4], rt[4];
+    asm volatile("ldmatrix.sync.aligned.m8n8.x4.shared.b16 {%0,%1,%2,%3}, [%4];\n"
